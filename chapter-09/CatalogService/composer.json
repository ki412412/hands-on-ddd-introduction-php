{
    "name": "catalogservice/catalog-service",
    "description": "CatalogService domain models",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CatalogService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CatalogService\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
